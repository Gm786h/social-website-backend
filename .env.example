# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://social-website-ty79.vercel.app,http://localhost:5173

# ── Auth ────────────────────────────────────────────────
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# ── Database (MySQL) ────────────────────────────────────
# Option A: a single connection URL (Railway sets DATABASE_PRIVATE_URL / DATABASE_URL)
# DATABASE_URL=mysql://user:password@localhost:3306/social_website
# Option B: individual settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=social_website
# Create missing tables on startup (leave false in production)
DB_SYNC=false
# Log SQL queries
DB_LOGGING=false

# ── Cloudinary (image uploads) ──────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
